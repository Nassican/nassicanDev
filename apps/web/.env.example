# Absolute base for canonical URLs, hreflang and OpenGraph.
# Defaults to https://nassican.com when unset.
NEXT_PUBLIC_SITE_URL="https://nassican.com"

# GA4 measurement id of the web data stream. Public by design: it ships in the
# page source. Scope it to Vercel's Production environment only - a value in
# Preview or Development would mix those sessions into the same property the
# admin dashboard reads.
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
