# Neon - same values as packages/db/.env
DATABASE_URL=""
DIRECT_DATABASE_URL=""

# Better Auth
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3001"

# Google Cloud > APIs & Services > Credentials > OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# The only account allowed to sign in. Comma-separated if it ever grows.
ADMIN_ALLOWED_EMAILS="nassicand@gmail.com"

# GA4 property id (numeric): what the Data API reads. Different from the
# measurement id the public site sends to - see apps/web/.env.example.
GA4_PROPERTY_ID=""

# Search Console identifies a site by string, not by a numeric id.
GSC_SITE_URL="sc-domain:nassican.com"

# Shared secret the admin sends to the public site to revalidate a cached tag.
REVALIDATE_SECRET=""
PUBLIC_SITE_URL="https://nassican.com"

# Vercel: despliegues y Web Analytics (módulos Sistema y Analítica).
#
# Estas variables viven en el entorno del PANEL, pero el token tiene que
# alcanzar el proyecto del SITIO PUBLICO: es nassican.com quien recibe las
# visitas. Al crear el token en Vercel -> Settings -> Tokens, elige el ambito
# donde vive nassican.com. El boton "Ver proyectos" de Sistema lista justo lo
# que el token alcanza: si nassican.com no sale ahi, el ambito esta mal.
# TEAM_ID solo si el proyecto pertenece a un equipo y no a la cuenta personal.
VERCEL_TOKEN=
VERCEL_PROJECT_WEB=
VERCEL_PROJECT_ADMIN=
VERCEL_TEAM_ID=

# Google: credencial para LEER GA4 y Search Console en segundo plano.
#
# Una service account, no el OAuth del operador. Motivo: una app OAuth en
# estado "Testing" emite refresh tokens que caducan a los 7 dias salvo que los
# unicos scopes sean de perfil, y analytics.readonly no lo es. Entrar al panel
# seguia funcionando (cada login emite token nuevo) mientras las dos
# sincronizaciones morian en silencio.
#
# Como obtenerla:
#   1. Google Cloud -> Cuentas de servicio -> crear -> clave JSON.
#   2. GA4 -> Admin -> Gestion de acceso -> anadir ese correo como Lector.
#   3. Search Console -> Configuracion -> Usuarios y permisos -> anadirlo.
#   4. Pegar aqui el JSON completo en base64 (o el JSON tal cual).
#
# Si queda vacia, el panel vuelve al token del operador, que caduca.
GOOGLE_SERVICE_ACCOUNT_KEY=

# Wallet (BudgetBakers): finanzas personales, SOLO LECTURA.
# El token se genera en los ajustes de la app web de Wallet y requiere plan
# Premium. La API da 300 peticiones/hora; una sincronizacion completa cuesta
# unas 10, asi que el presupuesto no es un problema salvo en bucles.
WALLET_API_TOKEN=
