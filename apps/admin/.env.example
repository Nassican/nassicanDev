# Neon - same values as packages/db/.env
DATABASE_URL=""
DIRECT_DATABASE_URL=""

# Better Auth
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3001"

# Google Cloud > APIs & Services > Credentials > OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# The only account allowed to sign in. Comma-separated if it ever grows.
ADMIN_ALLOWED_EMAILS="nassicand@gmail.com"

# GA4 property id (numeric): what the Data API reads. Different from the
# measurement id the public site sends to - see apps/web/.env.example.
GA4_PROPERTY_ID=""

# Search Console identifies a site by string, not by a numeric id.
GSC_SITE_URL="sc-domain:nassican.com"

# Shared secret the admin sends to the public site to revalidate a cached tag.
REVALIDATE_SECRET=""
PUBLIC_SITE_URL="https://nassican.com"

# Vercel: despliegues y Web Analytics (módulos Sistema y Analítica).
#
# Estas variables viven en el entorno del PANEL, pero el token tiene que
# alcanzar el proyecto del SITIO PUBLICO: es nassican.com quien recibe las
# visitas. Al crear el token en Vercel -> Settings -> Tokens, elige el ambito
# donde vive nassican.com. El boton "Ver proyectos" de Sistema lista justo lo
# que el token alcanza: si nassican.com no sale ahi, el ambito esta mal.
# TEAM_ID solo si el proyecto pertenece a un equipo y no a la cuenta personal.
VERCEL_TOKEN=
VERCEL_PROJECT_WEB=
VERCEL_PROJECT_ADMIN=
VERCEL_TEAM_ID=
