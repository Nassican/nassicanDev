// Data model for App Nassican, the management platform behind nassican.com.
//
// Two conventions run through the whole file:
//
//   1. Translations are rows, not columns. Every entity with visible text is
//      split into a base model and a `*Translation` sibling keyed by
//      (entityId, locale). Adding a language means inserting rows, not
//      migrating columns.
//   2. Long-form bodies stay as `ContentBlock[]` in a Json column. The shape is
//      declared in `src/content.ts` and applied on read by the client
//      extension in `src/index.ts` - Prisma types Json as opaque, so that
//      extension is the single sanctioned place where the cast happens.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection for the application.
  url       = env("DATABASE_URL")
  // Direct connection for migrations: Neon's pooler rejects session-level DDL.
  directUrl = env("DIRECT_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Mirrors `locales` in apps/web/src/lib/i18n/config.ts. The two must move
/// together; a test compares them.
enum Locale {
  es
  en
}

enum ContentStatus {
  draft
  scheduled
  published
  archived
}

enum UserRole {
  owner
  editor
  viewer
}

/// `system` pages already exist as routes under app/[locale]; only their SEO is
/// editable. `custom` pages are created in the panel and carry a body.
enum PageKind {
  system
  custom
}

enum EducationStatus {
  completed
  in_progress @map("in-progress")
}

enum MediaKind {
  image
  document
  video
  other
}

enum NavLocation {
  header
  /// The single call-to-action beside the header links. Its own location
  /// rather than a flag, so "there is exactly one" is a query, not a rule
  /// someone has to remember.
  header_cta
  footer
}

enum LinkKind {
  page
  route
  external
  /// An anchor on the homepage. `href` holds the bare section key ("about"),
  /// because whether it renders as "#about" or "/en/#about" depends on where
  /// the visitor already is.
  section
}

enum LogLevel {
  info
  warn
  error
}

enum SyncSource {
  ga4
  search_console
  vercel
  uptime
  content_stats
  link_check
  wallet
}

enum SyncStatus {
  running
  ok
  failed
}

// ---------------------------------------------------------------------------
// Access
// ---------------------------------------------------------------------------

/// Model names and fields in this block follow what the Better Auth Prisma
/// adapter expects. Only `role` and `isActive` are ours.
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified Boolean   @default(false)
  name          String?
  image         String?
  role          UserRole  @default(owner)
  /// Second lock, independent of Google: revoking access never needs the
  /// identity provider to cooperate.
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  posts         Post[]         @relation("PostAuthor")
  postRevisions PostRevision[]
  uploads       Media[]        @relation("MediaUploader")
  auditEntries  AuditLog[]
  trashed       TrashItem[]
  restorePoints RestorePoint[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Holds the Google OAuth grant. `refreshToken` is what lets the SEO and
/// Analytics modules query GA4 and Search Console without a service account.
model Account {
  id                    String    @id @default(cuid())
  /// The identity provider's own issuer URL - "https://accounts.google.com".
  /// Better Auth looks an account up by (issuer, accountId) rather than by
  /// provider name, so that the same subject from two configurations of the
  /// same provider is still one account. Required by the library, not by us.
  issuer                String
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([issuer, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// ---------------------------------------------------------------------------
// Blog
// ---------------------------------------------------------------------------

model Post {
  id          String        @id @default(uuid())
  slug        String        @unique
  status      ContentStatus @default(draft)
  /// A future date with status `scheduled` is a scheduled publication.
  publishedAt DateTime?     @map("published_at")
  /// Last edit with editorial weight, not every UPDATE.
  updatedAt   DateTime      @updatedAt @map("updated_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  authorId       String? @map("author_id")
  categoryId     String? @map("category_id")
  coverMediaId   String? @map("cover_media_id")
  featured       Boolean @default(false)
  /// Computed with readingMinutes() on save rather than on every render.
  readingMinutes Int?    @map("reading_minutes")

  author     User?     @relation("PostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  coverMedia Media?    @relation("PostCover", fields: [coverMediaId], references: [id], onDelete: SetNull)

  translations PostTranslation[]
  revisions    PostRevision[]
  tags         PostTag[]

  @@index([status, publishedAt])
  @@map("posts")
}

model PostTranslation {
  postId String @map("post_id")
  locale Locale

  title       String
  description String
  /// ContentBlock[] - see src/content.ts
  body        Json

  seoTitle       String?  @map("seo_title")
  seoDescription String?  @map("seo_description")
  ogImageId      String?  @map("og_image_id")
  canonicalUrl   String?  @map("canonical_url")
  noindex        Boolean  @default(false)
  updatedAt      DateTime @updatedAt @map("updated_at")

  post    Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  ogImage Media? @relation("PostOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)

  @@id([postId, locale])
  @@map("post_translations")
}

/// Lets an edit be undone without git. One row per save, per language.
model PostRevision {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  locale    Locale
  /// The whole PostTranslation row as it stood.
  snapshot  Json
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  post Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([postId, locale, createdAt])
  @@map("post_revisions")
}

model Category {
  id       String  @id @default(uuid())
  slug     String  @unique
  parentId String? @map("parent_id")
  position Int     @default(0)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  translations CategoryTranslation[]
  posts        Post[]

  @@map("categories")
}

model CategoryTranslation {
  categoryId  String  @map("category_id")
  locale      Locale
  name        String
  description String?

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([categoryId, locale])
  @@map("category_translations")
}

model Tag {
  id           String  @id @default(uuid())
  slug         String  @unique
  /// Display name, identical in every language: tags are technology names
  /// ("Next.js", "PostgreSQL"), not prose. This is what the public site puts
  /// in `PostMeta.tags`, and what `skills.ts` matches to resolve an icon.
  /// `TagTranslation` exists for the rare tag that is genuinely a phrase.
  label        String
  /// Resolves the icon by foreign key instead of by string match.
  technologyId String? @map("technology_id")

  technology   Technology?      @relation(fields: [technologyId], references: [id], onDelete: SetNull)
  translations TagTranslation[]
  posts        PostTag[]

  @@map("tags")
}

model TagTranslation {
  tagId  String @map("tag_id")
  locale Locale
  name   String

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([tagId, locale])
  @@map("tag_translations")
}

model PostTag {
  postId   String @map("post_id")
  tagId    String @map("tag_id")
  /// The order tags appear in is an editorial decision.
  position Int    @default(0)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("post_tags")
}

/// Outbound links extracted from bodies on save, so the SEO module can report
/// broken ones without re-parsing every post.
/// One row per distinct URL, not per place it appears.
///
/// The URL is what is or is not broken, so checking it once covers every
/// reference to it - and a diploma linked from three certificates is one
/// request, not three. `references` records where it was found on the last
/// scan, so a report can say *which* content points at a dead address.
///
/// This replaces the per-post link table and the per-certificate status
/// columns: outbound links rot the same way wherever they live, and one
/// checker beats three.
model OutboundLink {
  id  String @id @default(uuid())
  url String @unique

  status    Int?
  /// Null until checked. False means the last check failed.
  ok        Boolean?
  error     String?
  checkedAt DateTime? @map("checked_at")

  /// `{ entityType, entityId, locale, label }[]` - rebuilt on every scan.
  references  Json
  firstSeenAt DateTime @default(now()) @map("first_seen_at")

  @@index([ok])
  @@map("outbound_links")
}

// ---------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------

model Project {
  id           String        @id @default(uuid())
  slug         String        @unique
  /// Product name: not translated, so it lives on the base model.
  title        String
  /// "2024" or "2023 - 2024", exactly as shown next to the title.
  yearLabel    String        @map("year_label")
  date         DateTime      @db.Date
  status       ContentStatus @default(draft)
  /// Listed without a case study; the detail page says so explicitly rather
  /// than rendering an empty shell.
  comingSoon   Boolean       @default(false) @map("coming_soon")
  featured     Boolean       @default(false)
  demoUrl      String?       @map("demo_url")
  repoUrl      String?       @map("repo_url")
  coverMediaId String?       @map("cover_media_id")
  position     Int           @default(0)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  coverMedia   Media?               @relation("ProjectCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  translations ProjectTranslation[]
  technologies ProjectTechnology[]

  @@index([status, position])
  @@map("projects")
}

model ProjectTranslation {
  projectId String @map("project_id")
  locale    Locale

  /// The only required field, as today: a project can ship with just a tagline.
  tagline    String
  summary    String?
  role       String?
  /// string[] - sidebar bullets.
  highlights Json?
  /// ContentBlock[] - the case study itself.
  body       Json?

  seoTitle       String?  @map("seo_title")
  seoDescription String?  @map("seo_description")
  ogImageId      String?  @map("og_image_id")
  noindex        Boolean  @default(false)
  updatedAt      DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ogImage Media?  @relation("ProjectOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)

  @@id([projectId, locale])
  @@map("project_translations")
}

/// Replaces skillsRegistry in apps/web/src/lib/data/skills.ts.
model Technology {
  id          String  @id @default(uuid())
  /// "Next.js", "PostgreSQL" - the current registry key.
  key         String  @unique
  name        String
  hex         String
  textColor   String? @map("text_color")
  bgColor     String? @map("bg_color")
  borderColor String? @map("border_color")
  glow        String?
  glowOpacity Float?  @map("glow_opacity")
  /// react-icons component name.
  iconSlug    String? @map("icon_slug")

  /// The devicon this came from, so the panel can show which one is selected and
  /// refetch it if the upstream file changes.
  deviconName    String?  @map("devicon_name")
  /// "original" is the full-colour logo, "plain" the single-path monochrome one.
  deviconVariant String?  @map("devicon_variant")
  /// Applied when the sprite is built, not stored twice: switching is a column
  /// update and never another fetch.
  iconMode       IconMode @default(color) @map("icon_mode")

  /// The prepared markup, inlined straight into the page.
  ///
  /// Stored rather than fetched at render time for the same reason the images
  /// live in Postgres: the public site should not depend on a third party being
  /// up to draw itself. And **prepared**, not raw: `prepareIconSvg` renames every
  /// gradient id, because devicon numbers them `a`, `b`, `c` in every file and
  /// two inlined icons would otherwise share them. Measured on the twelve icons
  /// this project uses: 4 collisions out of 10 ids.
  iconSvg String? @map("icon_svg")

  projects   ProjectTechnology[]
  experience ExperienceTechnology[]
  groups     SkillGroupItem[]
  tags       Tag[]

  @@map("technologies")
}

model ProjectTechnology {
  projectId    String @map("project_id")
  technologyId String @map("technology_id")
  position     Int    @default(0)

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technology Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([projectId, technologyId])
  @@map("project_technologies")
}

model SkillGroup {
  id       String @id @default(uuid())
  /// frontend, backend, tools, databases
  key      String @unique
  position Int    @default(0)

  translations SkillGroupTranslation[]
  items        SkillGroupItem[]

  @@map("skill_groups")
}

model SkillGroupTranslation {
  groupId String @map("group_id")
  locale  Locale
  label   String

  group SkillGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, locale])
  @@map("skill_group_translations")
}

model SkillGroupItem {
  groupId      String @map("group_id")
  technologyId String @map("technology_id")
  position     Int    @default(0)

  group      SkillGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  technology Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([groupId, technologyId])
  @@map("skill_group_items")
}

// ---------------------------------------------------------------------------
// Profile
// ---------------------------------------------------------------------------

/// Single row, pinned to id 1. Prisma cannot express the CHECK constraint, so
/// it is added in the migration and enforced by the accessor in src/index.ts.
model Profile {
  id            Int      @id @default(1)
  fullName      String   @map("full_name")
  email         String
  /// { city, region, country }
  location      Json?
  /// { platform, url, label }[]
  socials       Json?
  avatarMediaId String?  @map("avatar_media_id")
  /// One media id per locale: { es: "...", en: "..." }
  cvMedia       Json?    @map("cv_media")
  updatedAt     DateTime @updatedAt @map("updated_at")

  avatar       Media?               @relation("ProfileAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  translations ProfileTranslation[]
  cvs          ProfileCv[]

  @@map("profile")
}

model ProfileTranslation {
  profileId Int    @map("profile_id")
  locale    Locale
  /// "Ingeniero de Sistemas"
  headline  String
  /// string[] - optional. The About section reads its paragraphs from the
  /// interface dictionary, not from here, so this stays empty unless the
  /// biography ever becomes editable content in its own right.
  bio       Json?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, locale])
  @@map("profile_translations")
}

/// One downloadable CV per language. A table rather than a field on `profile`
/// because its label is translated, and translations are rows.
model ProfileCv {
  id        String @id @default(uuid())
  profileId Int    @map("profile_id")
  /// ISO 639-1, for hrefLang and the schema's inLanguage. Not necessarily one
  /// of the site's own locales: a CV could exist in a language the site is not
  /// published in.
  lang      String
  href      String
  position  Int    @default(0)

  profile      Profile                @relation(fields: [profileId], references: [id], onDelete: Cascade)
  translations ProfileCvTranslation[]

  @@unique([profileId, lang])
  @@map("profile_cvs")
}

model ProfileCvTranslation {
  cvId   String @map("cv_id")
  locale Locale
  /// "CV en español" / "Resume in Spanish"
  label  String

  cv ProfileCv @relation(fields: [cvId], references: [id], onDelete: Cascade)

  @@id([cvId, locale])
  @@map("profile_cv_translations")
}

model Experience {
  id        String  @id @default(uuid())
  /// Organisation name, kept as written in both languages.
  org       String
  /// Partial ISO dates as authored - "2024", "2024-08", "2024-08-15" - because
  /// that precision is what reaches the <time datetime> attribute. Parsing them
  /// into a Date would silently change the rendered markup.
  startDate String  @map("start_date")
  /// Null while ongoing.
  endDate   String? @map("end_date")
  position  Int     @default(0)

  translations ExperienceTranslation[]
  technologies ExperienceTechnology[]

  @@map("experience")
}

model ExperienceTranslation {
  experienceId String @map("experience_id")
  locale       Locale
  title        String
  /// "ago. 2024 - dic. 2026" - date formatting differs per language, so the
  /// rendered label is stored rather than derived.
  periodLabel  String @map("period_label")
  description  String

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@id([experienceId, locale])
  @@map("experience_translations")
}

model ExperienceTechnology {
  experienceId String @map("experience_id")
  technologyId String @map("technology_id")
  position     Int    @default(0)

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  technology Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([experienceId, technologyId])
  @@map("experience_technologies")
}

model Education {
  id          String          @id @default(uuid())
  institution String
  /// Partial ISO dates as authored; see Experience.
  startDate   String          @map("start_date")
  endDate     String?         @map("end_date")
  /// Stated rather than derived from endDate: the site is statically built, so
  /// it cannot re-evaluate "has this finished yet" as time passes.
  status      EducationStatus @default(in_progress)
  link        String?
  position    Int             @default(0)

  translations EducationTranslation[]

  @@map("education")
}

model EducationTranslation {
  educationId String  @map("education_id")
  locale      Locale
  degree      String
  periodLabel String  @map("period_label")
  description String?

  education Education @relation(fields: [educationId], references: [id], onDelete: Cascade)

  @@id([educationId, locale])
  @@map("education_translations")
}

model Certificate {
  id            String  @id @default(uuid())
  /// "Platzi" - a proper name, kept as written in both languages.
  provider      String
  /// As written: often just a year, so it is a label rather than a date.
  dateLabel     String? @map("date_label")
  credentialUrl String  @map("credential_url")
  fileMediaId   String? @map("file_media_id")
  position      Int     @default(0)

  file         Media?                   @relation("CertificateFile", fields: [fileMediaId], references: [id], onDelete: SetNull)
  translations CertificateTranslation[]

  @@map("certificates")
}

model CertificateTranslation {
  certificateId String @map("certificate_id")
  locale        Locale
  title         String
  /// Feeds the filters on /certificates.
  category      String

  certificate Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@id([certificateId, locale])
  @@map("certificate_translations")
}

// ---------------------------------------------------------------------------
// Pages
// ---------------------------------------------------------------------------

model Page {
  id       String        @id @default(uuid())
  kind     PageKind      @default(custom)
  /// Canonical path with no locale prefix: "/", "/blog", "/certificates".
  route    String        @unique
  status   ContentStatus @default(draft)
  parentId String?       @map("parent_id")
  position Int           @default(0)

  sitemapPriority   Float?  @map("sitemap_priority")
  sitemapChangefreq String? @map("sitemap_changefreq")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent   Page?  @relation("PageTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Page[] @relation("PageTree")

  translations    PageTranslation[]
  navigationItems NavigationItem[]

  @@map("pages")
}

model PageTranslation {
  pageId String @map("page_id")
  locale Locale
  title  String
  /// ContentBlock[] - null on `system` pages, whose body lives in code.
  body   Json?

  seoTitle       String?  @map("seo_title")
  seoDescription String?  @map("seo_description")
  ogImageId      String?  @map("og_image_id")
  noindex        Boolean  @default(false)
  updatedAt      DateTime @updatedAt @map("updated_at")

  page    Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  ogImage Media? @relation("PageOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)

  @@id([pageId, locale])
  @@map("page_translations")
}

// ---------------------------------------------------------------------------
// Media
// ---------------------------------------------------------------------------

model Media {
  id          String    @id @default(uuid())
  kind        MediaKind @default(image)
  /// Path within Vercel Blob.
  storageKey  String    @map("storage_key")
  url         String
  mimeType    String    @map("mime_type")
  sizeBytes   BigInt    @map("size_bytes")
  /// next/image needs both to avoid layout shift.
  width       Int?
  height      Int?
  blurDataUrl String?   @map("blur_data_url")
  /// SHA-256 of the stored bytes. Doubles as the public filename, which is
  /// what makes the URL immutable: replacing an image changes the checksum, so
  /// the old URL is never served stale and the new one can be cached forever.
  checksum    String?   @unique
  folderId    String?   @map("folder_id")
  uploadedBy  String?   @map("uploaded_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  folder   MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploader User?        @relation("MediaUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)

  blob         MediaBlob?
  translations MediaTranslation[]
  usages       MediaUsage[]

  postCovers         Post[]               @relation("PostCover")
  postOgImages       PostTranslation[]    @relation("PostOgImage")
  projectCovers      Project[]            @relation("ProjectCover")
  projectOgImages    ProjectTranslation[] @relation("ProjectOgImage")
  pageOgImages       PageTranslation[]    @relation("PageOgImage")
  profileAvatars     Profile[]            @relation("ProfileAvatar")
  certificateFiles   Certificate[]        @relation("CertificateFile")
  seoDefaultOgImages SeoSettings[]        @relation("SeoDefaultOgImage")

  @@index([folderId])
  @@map("media")
}

/// The bytes themselves, in their own table on purpose: listing the media
/// library must never drag megabytes of binary along with it. Postgres keeps
/// values this large out of line in TOAST storage anyway, so the only cost of
/// splitting them is the join, and the only way to pay for the bytes is to ask
/// for them explicitly.
model MediaBlob {
  mediaId String @id @map("media_id")
  data    Bytes

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@map("media_blobs")
}

model MediaTranslation {
  mediaId String  @map("media_id")
  locale  Locale
  /// Visible text: CLAUDE.md requires both languages here too.
  alt     String
  caption String?
  title   String?

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([mediaId, locale])
  @@map("media_translations")
}

model MediaFolder {
  id       String  @id @default(uuid())
  /// Internal organisation only; never rendered, so not translated.
  name     String
  parentId String? @map("parent_id")

  parent   MediaFolder?  @relation("MediaFolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children MediaFolder[] @relation("MediaFolderTree")
  media    Media[]

  @@map("media_folders")
}

/// Turns "delete image" from a blind operation into one with an answer:
/// this image appears in 3 posts and 1 project. Recomputed on every body save.
model MediaUsage {
  id         String  @id @default(uuid())
  mediaId    String  @map("media_id")
  entityType String  @map("entity_type")
  entityId   String  @map("entity_id")
  locale     Locale?
  /// "cover", "og_image", or "body".
  field      String

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, entityType, entityId, field, locale])
  @@index([entityType, entityId])
  @@map("media_usages")
}

