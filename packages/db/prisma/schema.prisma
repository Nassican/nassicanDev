model Redirect {
  id          String    @id @default(uuid())
  source      String    @unique
  destination String
  statusCode  Int       @default(308) @map("status_code")
  isEnabled   Boolean   @default(true) @map("is_enabled")
  /// Shows which redirects nobody follows any more and can be retired.
  hits        BigInt    @default(0)
  lastHitAt   DateTime? @map("last_hit_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("redirects")
}

/// The five dimensions the Search Console API returns. Rows are pruned past
/// 16 months, which is Search Console's own retention.
model SearchConsoleDaily {
  date        DateTime @db.Date
  page        String
  query       String
  country     String
  device      String
  clicks      Int      @default(0)
  impressions Int      @default(0)
  ctr         Float    @default(0)
  /// Average position; comparing across dates gives the trend.
