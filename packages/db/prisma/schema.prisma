model SeoSettings {
  id            Int     @id @default(1)
  /// Informational only: the public site reads NEXT_PUBLIC_SITE_URL instead.
  /// The origin is deployment configuration, not content - a preview and
  /// production share these rows and must not share a canonical.
  siteUrl       String  @map("site_url")
  titleTemplate String? @map("title_template")

  defaultOgImageId String? @map("default_og_image_id")

  googleSiteVerification String?  @map("google_site_verification")
  /// Target of the GA4 Data API queries.
  ga4PropertyId          String?  @map("ga4_property_id")
  /// G-XXXXXXX - the tag the public site loads.
  ga4MeasurementId       String?  @map("ga4_measurement_id")
  /// sc-domain:nassican.com
  gscSiteUrl             String?  @map("gsc_site_url")
  /// Appended to the generated robots.txt.
