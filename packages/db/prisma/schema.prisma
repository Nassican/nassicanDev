// ---------------------------------------------------------------------------
// Configuration
// ---------------------------------------------------------------------------

/// Site-wide knobs, one row. Everything here is wired to something the public
/// site actually does - a setting nobody reads is worse than no setting.
///
/// The contact address is **not** here: `profile.email` owns it, and a second
/// column holding the same address is a second answer waiting to disagree.
model SiteSettings {
  id                   Int      @id @default(1)
  /// The value themeInitScript applies when no cookie is set.
  defaultTheme         String   @default("dark") @map("default_theme")
  /// Decides which calendar day a snapshot belongs to. Google's own rollups
  /// use the property's timezone, not this one.
  timezone             String   @default("America/Bogota")
  maintenanceMode      Boolean  @default(false) @map("maintenance_mode")
  /// Proper nouns, so they are not translated: the line under the name in the
  /// footer, and the name in the copyright notice.
  brandLine            String   @default("Nassican Group") @map("brand_line")
  copyrightName        String   @default("Nassican") @map("copyright_name")
  /// How many articles the homepage teaser shows.
  latestPostsCount     Int      @default(2) @map("latest_posts_count")
  showSectionNavigator Boolean  @default(true) @map("show_section_navigator")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model NavigationItem {
  id        String      @id @default(uuid())
  location  NavLocation
  parentId  String?     @map("parent_id")
  /// `page` resolves the destination through `pages`, so renaming a route
  /// never breaks the menu. `external` stores the literal URL.
  kind      LinkKind    @default(page)
  pageId    String?     @map("page_id")
  /// Unprefixed path; localePath() adds the locale.
  href      String?
  position  Int         @default(0)
  isVisible Boolean     @default(true) @map("is_visible")

  parent   NavigationItem?  @relation("NavTree", fields: [parentId], references: [id], onDelete: SetNull)
  children NavigationItem[] @relation("NavTree")
  page     Page?            @relation(fields: [pageId], references: [id], onDelete: SetNull)

  translations NavigationItemTranslation[]

  @@index([location, position])
  @@map("navigation_items")
}

model NavigationItemTranslation {
  itemId    String  @map("item_id")
  locale    Locale
  label     String
  /// aria-label is visible text to a screen reader, so it is translated.
  ariaLabel String? @map("aria_label")

  item NavigationItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([itemId, locale])
  @@map("navigation_item_translations")
}

/// Reorder or hide homepage sections without a deploy.
model HomeSection {
  key       String  @id
  position  Int     @default(0)
  isVisible Boolean @default(true) @map("is_visible")

  @@map("home_sections")
}

// ---------------------------------------------------------------------------
// Finanzas personales (espejo de solo lectura de Wallet)
// ---------------------------------------------------------------------------

/// A local mirror of BudgetBakers Wallet, read-only by construction.
///
/// Why a copy and not live calls: the API allows 300 requests an hour and at
/// most two filter conditions per query, while the point of the module is to
/// sort and filter by date, amount, category and account at once. One page view
/// would cost several requests and still have to sort in memory. Mirrored, it is
/// ordinary SQL - the same pattern GA4, Search Console and Vercel already use
/// here.
///
/// **No foreign keys between these tables, on purpose.** This is somebody
/// else's data: an account can disappear from the API while its records remain,
/// and a referential constraint would turn that into a failed sync instead of a
/// row with a stale name. Wallet already denormalises the names into each
/// record, so the mirror keeps them and stays self-sufficient for listing.
model WalletAccount {
  /// Wallet's own id, so a resync updates rather than duplicates.
  id               String  @id
  name             String
  accountType      String  @map("account_type")
  currencyCode     String  @map("currency_code")
  color            String?
  archived         Boolean @default(false)
  /// Wallet's own flag: these are left out of its statistics, so the panel
  /// must be able to leave them out too rather than quietly disagreeing.
  excludeFromStats Boolean @default(false) @map("exclude_from_stats")
  isBankSync       Boolean @default(false) @map("is_bank_sync")

  /// Money as `numeric`, never float. The API sends JSON numbers; storing them
  /// as doubles is how a balance ends in .00000000001.
  initialBalance Decimal @default(0) @map("initial_balance") @db.Decimal(18, 4)
  currentBalance Decimal @default(0) @map("current_balance") @db.Decimal(18, 4)
  recordCount    Int     @default(0) @map("record_count")

  /// Nullable because Wallet does not always send them. A record came back
  /// with no `createdAt` after 460 good ones, and a required column turned that
  /// into a failed sync. A mirror of somebody else's data cannot insist on a
  /// field the source treats as optional - and inventing a date to fill the gap
  /// would be worse than admitting it is unknown.
  createdAt DateTime? @map("created_at")
  updatedAt DateTime? @map("updated_at")
  syncedAt  DateTime  @default(now()) @map("synced_at")

  @@index([archived])
  @@map("wallet_accounts")
}

model WalletCategory {
  id             String  @id
  name           String
  groupId        String? @map("group_id")
  groupName      String? @map("group_name")
  color          String?
  /// Wallet's stable key for a built-in category, e.g. `financial_expenses__taxes`.
  systemId       String? @map("system_id")
  /// `must` | `want` | … - Wallet's own needs-vs-wants tag.
  cardinality    String?
  customCategory Boolean @default(false) @map("custom_category")
  archived       Boolean @default(false)

  createdAt DateTime? @map("created_at")
  updatedAt DateTime? @map("updated_at")
  syncedAt  DateTime  @default(now()) @map("synced_at")

  @@index([groupId])
  @@map("wallet_categories")
}

model WalletRecord {
  id          String @id
  accountId   String @map("account_id")
  /// Denormalised from the API, which sends it on every record. It is what
  /// lets a listing render without a join and survive an account vanishing.
  accountName String @map("account_name")

  categoryId    String? @map("category_id")
  categoryName  String? @map("category_name")
  categoryGroup String? @map("category_group")

  /// Negative for an expense, exactly as Wallet sends it. Not normalised to a
  /// positive number plus a sign column: the source's convention is the one
  /// thing a mirror must not reinterpret.
  amount       Decimal @db.Decimal(18, 4)
  currencyCode String  @map("currency_code")

  /// Wallet stores a date-only record at 12:00:00Z, so the day is read in UTC
  /// and midnight comparisons would miss it. Kept as sent.
  recordDate  DateTime @map("record_date")
  recordType  String   @map("record_type")
  recordState String   @map("record_state")

  note         String?
  counterParty String? @map("counter_party")
  /// `string[]` of label ids; kept raw because the module only filters by them.
  labels       Json?
  transferId   String? @map("transfer_id")
  source       String?

  createdAt DateTime? @map("created_at")
  updatedAt DateTime? @map("updated_at")
  syncedAt  DateTime  @default(now()) @map("synced_at")

  @@index([recordDate])
  @@index([accountId, recordDate])
  @@index([categoryId, recordDate])
  @@index([recordType])
  @@map("wallet_records")
}

model WalletBudget {
  id           String  @id
  name         String
  limitAmount  Decimal @map("limit_amount") @db.Decimal(18, 4)
  currencyCode String  @map("currency_code")
  /// `BUDGET_INTERVAL_MONTH` and friends.
  type         String
  closed       Boolean @default(false)
  /// Empty means every account / every category, which is Wallet's own
  /// convention and not a missing value.
  accountIds   Json    @map("account_ids")
  categoryIds  Json    @map("category_ids")

  createdAt DateTime? @map("created_at")
  updatedAt DateTime? @map("updated_at")
  syncedAt  DateTime  @default(now()) @map("synced_at")

  @@map("wallet_budgets")
}

// ---------------------------------------------------------------------------
// System
// ---------------------------------------------------------------------------

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  userId     String?  @map("user_id")
  /// create, update, publish, delete
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  /// Only the fields that changed, before and after.
  diff       Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

/// One row per synchroniser run. An expired Google token surfaces here rather
/// than nowhere.
model SyncRun {
  id          String     @id @default(uuid())
  source      SyncSource
  rangeStart  DateTime?  @map("range_start") @db.Date
  rangeEnd    DateTime?  @map("range_end") @db.Date
  status      SyncStatus @default(running)
  rowsWritten Int        @default(0) @map("rows_written")
  error       String?
  startedAt   DateTime   @default(now()) @map("started_at")
  finishedAt  DateTime?  @map("finished_at")

  @@index([source, startedAt])
  @@map("sync_runs")
}

model SystemEvent {
  id        BigInt   @id @default(autoincrement())
  level     LogLevel @default(info)
  source    String
  message   String
  context   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([level, createdAt])
  @@map("system_events")
}

/// Vercel Web Analytics, synced daily.
///
/// One table with a dimension discriminator rather than one per grouping,
/// because Vercel answers every grouping with the same two numbers - unlike
/// GA4, where each report carries its own metrics and needed its own shape.
/// `dimension` is "total" for the day's own row, and `value` is empty there
/// because there is nothing to name.
model VercelAnalyticsDaily {
  date      DateTime @db.Date
  dimension String
  value     String
  pageviews Int      @default(0)
  visitors  Int      @default(0)

  @@id([date, dimension, value])
  @@index([dimension, date])
  @@map("vercel_analytics_daily")
}

model Deployment {
  /// Vercel's own deployment id.
  id        String    @id
  /// web | admin
  project   String
  commitSha String?   @map("commit_sha")
  branch    String?
  state     String
  createdAt DateTime  @map("created_at")
  /// Its distance from createdAt is the build duration.
  readyAt   DateTime? @map("ready_at")

  @@index([project, createdAt])
  @@map("deployments")
}

model UptimeCheck {
  id         BigInt   @id @default(autoincrement())
  url        String
  checkedAt  DateTime @default(now()) @map("checked_at")
  statusCode Int?     @map("status_code")
  responseMs Int?     @map("response_ms")
  isOk       Boolean  @map("is_ok")

  @@index([url, checkedAt])
  @@map("uptime_checks")
}

// ---------------------------------------------------------------------------
// Games
// ---------------------------------------------------------------------------

/// Where the game lives, which is the launcher and not the shop that sold it:
/// a key bought on Eneba is played on Ubisoft Connect, and what you want to
/// know later is where to click.
/// How a technology logo is painted.
///
/// `color` is the brand mark with its own colours. `mono` strips them and lets it
/// inherit `currentColor`, which is the only way a dark logo like Express stays
/// visible on a dark background — and the way to keep a page from being a parade
/// of clashing brand palettes.
enum IconMode {
  color
  mono
}

enum GamePlatform {
  ubisoft
  gog
  steam
  epic
  xbox
  playstation
  microsoft
  other
}

/// Four states, and `backlog` is the one the whole module exists for: a library
/// nobody tracks answers "what do I own", and the useful question is "what did
/// I buy and never open".
enum GameStatus {
  /// Not owned yet. Kept apart from `backlog` because every money figure in
  /// the module is about what was spent, and a wish has not been spent.
  wishlist
  backlog
  playing
  finished
  dropped
}

/// Where a game was bought.
///
/// A table and not an enum, which is the difference between the two fields it
/// sits next to. **Launchers are a closed set you do not invent** — Steam,
/// Ubisoft Connect, GOG Galaxy, Epic — and adding one is a rare, deliberate act.
/// **Stores are open**: Eneba, Humble, Fanatical, Instant Gaming and the next
/// key reseller that appears. Making the operator deploy to record a purchase
/// from a new shop is the kind of friction that ends with the field left empty.
model GameStore {
  id       String @id @default(uuid())
  /// Stable and lowercase; what an import matches on.
  key      String @unique
  name     String
  position Int    @default(0)

  games Game[]

  @@map("game_stores")
}

/// A game, entered by hand.
///
/// **Deliberately not derived from the Wallet mirror**, although the purchase
/// notes there do name most of them. A library is not a payment log: a free Epic
/// giveaway has no record in Wallet at all, so deriving the list would have made
/// "games I never opened" wrong from the first row — and that is the number the
/// module is for.
///
/// Not translated either. Nothing here reaches a visitor, and `apps/admin` is
/// Spanish only; the bilingual rule covers what the site says, not what the
/// operator tracks.
model Game {
  id       String       @id @default(uuid())
  title    String
  /// Where it runs — the launcher you open.
  platform GamePlatform @default(other)
  /// Where it was bought, which is a different question: 9 of these 96 were
  /// bought on Steam and run on Ubisoft Connect. Keeping one field would have
  /// forced a wrong answer on every one of those rows. Optional because the
  /// honest answer is sometimes that nobody remembers.
  storeId  String?      @map("store_id")
  store    GameStore?   @relation(fields: [storeId], references: [id], onDelete: SetNull)
  status   GameStatus   @default(backlog)

  /// Hours played, as the launcher reports them. Null means "not recorded",
  /// which is a different thing from zero: zero is a game opened and quit.
  hours Float?

  /// What it cost, typed by hand and in COP. Optional because a gift and a
  /// giveaway are both real ways to own a game, and a 0 there would read as
  /// free when it means unknown.
  price Decimal? @db.Decimal(14, 2)

  /// Kept as text, like the experience and education dates: "2024", "2024-08"
  /// and "2024-08-13" are partial dates written as they were known, and parsing
  /// them would invent a precision nobody had.
  purchasedAt String? @map("purchased_at")
  finishedAt  String? @map("finished_at")

  note String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([platform])
  @@map("games")
}

// ---------------------------------------------------------------------------
// Books
// ---------------------------------------------------------------------------

/// How it is read, which changes what «páginas» means: an audiobook has none,
/// and a physical copy cannot be searched. Not «where it was bought» — that is
/// not something you need to know again later.
enum BookFormat {
  physical
  ebook
  audiobook
}

/// The same four states as the games library, and `backlog` is again the one the
/// module exists for: a shelf answers "what do I own", and the useful question
/// is "what did I buy and never open".
enum BookStatus {
  /// A book you want to buy. Same reason as the games: it is not yours yet, so
  /// it cannot count towards what the shelf cost.
  wishlist
  backlog
  reading
  finished
  dropped
}

/// A book, entered by hand.
///
/// Its own table rather than a shared `LibraryItem` with a `kind`: the fields
/// that matter genuinely differ — a book has an author and pages, a game has a
/// launcher and hours — and a shared model would have been four nullable columns
/// and a discriminator standing in for two honest tables. What they *do* share is
/// the reading of their fields, which lives in `draft-fields.ts`.
///
/// Not translated, like the games: nothing here reaches a visitor.
model Book {
  id     String  @id @default(uuid())
  title  String
  author String?
  /// Normalised to ISBN-13, digits only, whatever form it was typed in. It is
  /// what «Completar» looks the book up by, and an ISBN-10 and its ISBN-13 are
  /// the same edition — storing both spellings would make one book look like two.
  isbn   String?

  format BookFormat @default(physical)
  status BookStatus @default(backlog)

  /// Total pages, and how many are read. Both optional, and both meaningless for
  /// an audiobook — left blank there rather than given a unit that lies.
  pages     Int?
  pagesRead Int? @map("pages_read")

  price Decimal? @db.Decimal(14, 2)

  /// Partial dates kept as text, as everywhere else in this schema.
  purchasedAt String? @map("purchased_at")
  finishedAt  String? @map("finished_at")

  note String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([author])
  @@index([isbn])
  @@map("books")
}

// ---------------------------------------------------------------------------
// Trash
// ---------------------------------------------------------------------------

enum TrashKind {
  post
  project
  page
  media
  game
  book
  subscription
  journal
  task
  goal
  habit
}

/// What a deletion took away, kept for thirty days so it can be put back.
///
/// **A snapshot and not a `deletedAt` column**, and that is the decision the
/// table exists for. A column would have to be filtered out of every query in
/// both apps — forgetting one on the public site means a deleted article is
/// still served, in silence. Here a deletion is still a real `DELETE`: nothing
/// that reads the content can see a trashed row, because there is no row.
///
/// The cost is that restoring has to rebuild the rows, and anything they pointed
/// at may have gone in the meantime. `restoreSnapshot` reports that rather than
/// failing on it.
model TrashItem {
  id        String    @id @default(uuid())
  kind      TrashKind
  /// The deleted row's id, which is also the id it comes back with — so links
  /// and audit entries that name it still mean the same thing after a restore.
  entityId  String    @map("entity_id")
  /// What the list shows: a title, a slug or a route, as it was at deletion.
  label     String
  /// `{ parts, backlinks }`, written by `packages/db/src/backup.ts`.
  payload   Json
  sizeBytes Int       @map("size_bytes")
  deletedBy String?   @map("deleted_by")
  deletedAt DateTime  @default(now()) @map("deleted_at")

  user User? @relation(fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([deletedAt])
  @@map("trash_items")
}

/// The whole database as it stood just before a restore from the panel.
///
/// What makes that restore **undoable**: replacing every content table is the
/// most destructive thing the panel can do, and the one most likely to be done
/// with the wrong file. A point is taken before every restore — reverting to a
/// point takes another — and the newest five are kept.
///
/// Stored in the same database it protects, and that is not a contradiction:
/// it guards against a restore that went wrong, not against losing Neon. That is
/// what the downloaded copy is for, and why this table is left out of it.
model RestorePoint {
  id        String   @id @default(uuid())
  /// What it was taken before, in the words the list shows.
  reason    String
  /// A backup file, gzipped — the same bytes the download produces.
  data      Bytes
  sizeBytes Int      @map("size_bytes")
  rows      Int
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("restore_points")
}

// ---------------------------------------------------------------------------
// Subscriptions
// ---------------------------------------------------------------------------

enum Currency {
  COP
  USD
  EUR
}

/// Whether it is still being paid. `cancelled` keeps its history: knowing what
/// you used to pay for, and for how long, is half of deciding the next one.
enum SubscriptionStatus {
  active
  paused
  cancelled
}

/// Something paid again and again, entered by hand.
///
/// **Not derived from the Wallet mirror**, by the operator's decision and with
/// the numbers to back it: grouping repeated charges found Netflix and Tigo next
/// to D1 and Mercado Libre, split Tigo under two names, and missed Claude and
/// Google One entirely — billed in dollars, yearly, or from another account.
model Subscription {
  id             String             @id @default(uuid())
  name           String
  /// Free text with suggestions — «Streaming», «Infraestructura» — because the
  /// useful groups are the operator's, not a fixed list.
  category       String?
  price          Decimal            @db.Decimal(14, 2)
  currency       Currency           @default(COP)
  /// 1 monthly, 3 quarterly, 12 yearly. A number and not an enum, so a
  /// six-monthly plan is a value and not a migration.
  intervalMonths Int                @default(1) @map("interval_months")
  status         SubscriptionStatus @default(active)
  /// Partial date text, optionally with a time: "2026-11", "2026-11-03",
  /// "2026-11-03T09:00". The same convention as every hand-typed date here.
  nextRenewal    String?            @map("next_renewal")
  startedAt      String?            @map("started_at")
  /// Which card or account pays it — what you need to know to cancel it.
  paymentMethod  String?            @map("payment_method")
  /// Where to manage or cancel it.
  url            String?
  note           String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  payments SubscriptionPayment[]

  @@index([status])
  @@map("subscriptions")
}

/// One period marked as paid.
///
/// Keyed by the month it covers, not by the day it was charged: «¿pagué
/// septiembre?» is the question, and a charge on the 31st of August for
/// September has to answer it. The day, if known, is `paidAt`.
model SubscriptionPayment {
  id             String    @id @default(uuid())
  subscriptionId String    @map("subscription_id")
  /// "2026-09": the month this payment covers.
  period         String
  /// What was actually charged, which drifts from the list price.
  amount         Decimal?  @db.Decimal(14, 2)
  currency       Currency?
  /// Partial date text with optional time, as above.
  paidAt         String?   @map("paid_at")
  note           String?
  createdAt      DateTime  @default(now()) @map("created_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, period])
  @@map("subscription_payments")
}

// ---------------------------------------------------------------------------
// Journal
// ---------------------------------------------------------------------------

/// A line written by hand in the weekly log.
///
/// The automatic half of the week — what was published, finished, paid — is
/// read from the audit log and the modules at render time, never copied here:
/// a summary stored next to its sources is a second answer waiting to disagree.
model JournalEntry {
  id        String   @id @default(uuid())
  /// "2026-10-04" or "2026-10-04T21:30". A full day is required: an entry
  /// belongs to one week, and «2026-10» does not say which.
  at        String
  text      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([at])
  @@map("journal_entries")
}

/// The note on a week as a whole: what went well, what comes next.
model JournalWeek {
  /// The Monday that starts it, "2026-09-28".
  week      String   @id
  /// Free notes on the week. Optional since the guided review arrived: a week
  /// can be reviewed through the questions alone.
  summary   String?
  /// The guided review: what went well, and what to change.
  wentWell  String?  @map("went_well")
  change    String?
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("journal_weeks")
}

/// What the weekly review set out to do the following week.
///
/// Stored against the week it is **for**, not the week it was written in: the
/// review of week 40 writes week 41's priorities, and week 41 is where they are
/// ticked. Its own rows rather than JSON on `JournalWeek`, so a priority can be
/// ticked on its own without rewriting the review around it.
model WeekPriority {
  id       String  @id @default(uuid())
  /// The Monday of the week this priority is for.
  week     String
  position Int     @default(0)
  text     String
  done     Boolean @default(false)

  @@index([week])
  @@map("week_priorities")
}

// ---------------------------------------------------------------------------
// Tasks
// ---------------------------------------------------------------------------

/// Where a task stands. `dropped` is a real outcome and not a failure: deciding
/// not to do something takes it off your mind as surely as doing it.
enum TaskStatus {
  inbox
  planned
  done
  dropped
}

/// Something to do, captured in two seconds and planned later.
///
/// **A task leaves the inbox only with a day.** The research behind the module
/// is Masicampo and Baumeister (2011): an unfinished task keeps intruding on
/// whatever you do next, and what stops it is not finishing it but making a
/// concrete plan for when. A list of things without dates is exactly the list
/// that keeps intruding.
model Task {
  id         String     @id @default(uuid())
  title      String
  note       String?
  /// Free text with suggestions — «nassican», «personal», «casa» — like the
  /// subscription categories: the useful groups are the operator's own.
  area       String?
  status     TaskStatus @default(inbox)
  /// "2026-10-06" or "2026-10-06T09:00". A full day: «2026-10» is not a plan.
  plannedFor String?    @map("planned_for")
  /// When it was finished or dropped, so the week it happened is known.
  closedAt   DateTime?  @map("closed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, plannedFor])
  @@map("tasks")
}

// ---------------------------------------------------------------------------
// Goals and habits
// ---------------------------------------------------------------------------

enum GoalStatus {
  active
  achieved
  dropped
}

/// Where a goal's progress is counted from, when it is not counted by hand.
/// Each reads rows the panel already has, so the goal moves when the work does.
enum GoalSource {
  books_finished
  games_finished
  posts_published
  tasks_done
}

/// A goal, with the plan that gets it done.
///
/// **The plan is required, not the deadline.** The evidence behind the module is
/// the implementation-intention meta-analyses (Gollwitzer and Sheeran, 2006;
/// Sheeran, Listrom and Gollwitzer, 2024): writing the plan as «if X, then Y»
/// has a medium-to-large effect on reaching the goal, larger in that conditional
/// form. A goal without one is a wish, and the form refuses to store wishes.
model Goal {
  id    String  @id @default(uuid())
  title String
  /// Why it matters. Optional, and shown next to the plan when there is one.
  why   String?

  /// The implementation intention, in its two halves.
  planIf   String @map("plan_if")
  planThen String @map("plan_then")

  /// Partial date text, like every hand-typed date here.
  deadline String?
  status   GoalStatus @default(active)

  /// A number to reach, and what it counts. Both optional: «aprender a nadar»
  /// is a goal with no number, and inventing one would be worse than none.
  target   Int?
  unit     String?
  /// Counted by hand when `source` is null.
  progress Int         @default(0)
  source   GoalSource?
  /// What an automatic source counts from, «2026-01-01». Partial date text.
  since    String?

  closedAt  DateTime? @map("closed_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@map("goals")
}

/// A habit: a small action tied to a cue, ticked on the days it is due.
model Habit {
  id        String   @id @default(uuid())
  title     String
  /// The cue that triggers it — «después de almorzar». Required for the same
  /// reason as a goal's plan: a habit forms around a context, and «every day,
  /// somehow» is not one.
  cue       String
  /// Due weekdays, Monday first: "1234567" is every day, "135" Mon/Wed/Fri.
  days      String   @default("1234567")
  archived  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  checks HabitCheck[]

  @@map("habits")
}

/// One day a habit was done. A row per tick, keyed by the local day.
model HabitCheck {
  habitId String @map("habit_id")
  /// "2026-10-05", the operator's local day.
  date    String

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@id([habitId, date])
  @@map("habit_checks")
}
