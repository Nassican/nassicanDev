# Neon. Both come from the same project; the console shows each one.
#
# Pooled connection for the application. Prisma needs `pgbouncer=true` so it
# stops using prepared statements, which the pooler does not support.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Direct connection for migrations: the pooler rejects session-level DDL.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"
